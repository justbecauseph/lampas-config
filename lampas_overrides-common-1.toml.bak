["General Settings"]
	#The full URL of the webhook endpoint to notify when player events occur.
	webhookUrl = "https://portal.lampas.town/api/minecraft/user-sync"
	#API key to be sent in the 'x-api-key' header for authorization.
	apiKey = "GG88gGj25EuqDrdLYQyDqkE8CWZPAH"
	#The full URL of the separate endpoint to notify with bank balance and user details when bank deposits/withdrawals occur.
	bankSyncUrl = "https://portal.lampas.town/api/minecraft/bank-sync"
	#The full URL of the player API endpoint to retrieve player roles.
	playerApiUrl = "https://portal.lampas.town/api/minecraft/player"
	#Whether newly created Tax Collectors will default to Force Acceptance being enabled.
	taxCollectorForceAcceptance = true
	#The full URL of the bounties API endpoint to retrieve and claim bounties.
	bountiesApiUrl = "https://portal.lampas.town/api/minecraft/bounties"
	#The full URL of the player death API endpoint to notify when a player dies.
	playerDeathApiUrl = "https://portal.lampas.town/api/minecraft/player-death"
	#The full URL of the socials API endpoint used to fetch players' linked YouTube/Twitch channels for chat icons. This is a public endpoint (no API key needed), so the default points at the live web app for client modpacks.
	socialsApiUrl = "https://portal.lampas.town/api/minecraft/socials"
	#Whether to prepend YouTube/Twitch icons to chat messages from players who have linked a channel. Client-side only.
	showSocialIcons = true
	#If true, Cheesy/Lactose Intolerant are replaced with Plague/Infected. Toggle in-game with /plaguemode to migrate already-applied effects on online players live; editing this value directly only affects newly-applied effects.
	plagueMode = false

["Player Ladder Settings"]
	#Action that occurs when you click on a player/entity.
	#Allowed Values: RIDE, PICK_UP, DO_NOTHING
	rightClickMode = "RIDE"
	#Limits how many entities a player can pick up.
	# Default: 16
	# Range: > 1
	pickUpLimit = 16
	#Limits how many entities up a player can go.
	# Default: 16
	# Range: > 1
	stepUpLimit = 16
	#Allows riding or picking up any living entity.
	allowLivingEntities = false
	#Allows riding or picking up any player.
	allowPlayers = true
	#The list of living entities that can't be ridden/picked up. Supports entity tags e.g: #minecraft:dismounts_underwater
	excludedLivingEntities = ["minecraft:wither", "minecraft:ender_dragon", "minecraft:minecart", "#minecraft:boat", "#minecraft:dismounts_underwater", "minecraft:horse", "minecraft:donkey", "minecraft:mule", "minecraft:skeleton_horse", "minecraft:zombie_horse", "minecraft:camel"]
	#Allows the /ride command to mount entities on top of players.
	rideCommandExtension = true
	#Allows interacting with the world while there's an entity on top of you.
	allowInteractions = true
